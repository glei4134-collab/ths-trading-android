<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:gravity="start" android:paddingVertical="4dp">
    <TextView android:id="@+id/chatContent" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:background="@drawable/bg_card"
        android:textColor="#e6edf3" android:textSize="14sp" android:padding="12dp"
        android:maxWidth="280dp" />
    <TextView android:id="@+id/chatTime" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:textColor="#8b949e"
        android:textSize="10sp" android:layout_marginTop="2dp" />
</LinearLayout>
