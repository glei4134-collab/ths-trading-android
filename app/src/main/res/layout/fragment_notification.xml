<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="#0f1923">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="通知" android:textColor="#e6edf3" android:textSize="18sp"
        android:textStyle="bold" android:padding="16dp" android:background="#16213e" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/notifList"
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:padding="12dp" />
</LinearLayout>
