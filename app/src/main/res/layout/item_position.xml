<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingVertical="10dp"
    android:paddingHorizontal="4dp">
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/posName" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#e6edf3" android:textSize="13sp" android:textStyle="bold" />
        <TextView android:id="@+id/posCode" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#8b949e" android:textSize="10sp" android:layout_marginTop="2dp" />
    </LinearLayout>
    <TextView android:id="@+id/posProfit" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="#f85149" android:textSize="13sp" android:textStyle="bold" />
</LinearLayout>
